<UserControl x:Class="FlowlyDesktop.Views.ProyectoFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Administración / Proyectos" Style="{StaticResource Breadcrumb}"/>
        <TextBlock x:Name="Titulo" Text="Crear proyecto" Style="{StaticResource H1}"/>
        <TextBlock Text="Define el alcance y el calendario antes de incorporar las tareas." Style="{StaticResource Sub}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Datos del proyecto" Style="{StaticResource H2}"/>

                    <TextBlock Text="Nombre del proyecto *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="Nombre" MaxLength="120"/>

                    <TextBlock Text="Descripción *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="Descripcion" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fecha de inicio *" Style="{StaticResource Label}"/>
                            <DatePicker x:Name="FechaInicio"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fecha de fin *" Style="{StaticResource Label}"/>
                            <DatePicker x:Name="FechaFin"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="La fecha de fin debe ser posterior al inicio." Style="{StaticResource Muted}"/>

                    <TextBlock Text="Grupo / ciclo *" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="Equipo" DisplayMemberPath="Nombre"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,60,0,0">
                <StackPanel>
                    <TextBlock Text="Siguiente paso" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock Text="Las tareas se crean desde la sección Tareas: podrás asignar personas, definir dependencias y estimar las horas de trabajo."
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="Responsable" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="Error" Style="{StaticResource ErrorText}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="Guardar" Content="Crear proyecto" Style="{StaticResource PrimaryButton}" Click="Guardar_Click"/>
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Cancelar_Click"/>
        </StackPanel>
        <TextBlock Text="* Campos obligatorios" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
