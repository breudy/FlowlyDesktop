<UserControl x:Class="FlowlyDesktop.Views.UsuarioFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Administración / Usuarios" Style="{StaticResource Breadcrumb}"/>
        <TextBlock x:Name="Titulo" Text="Crear usuario" Style="{StaticResource H1}"/>
        <TextBlock Text="Añade una persona al equipo del proyecto académico." Style="{StaticResource Sub}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Datos del usuario" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre *" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Nombre" MaxLength="60"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Apellidos *" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <TextBox x:Name="Apellidos" MaxLength="100"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Correo electrónico *" Style="{StaticResource Label}"/>
                    <TextBox x:Name="Email" MaxLength="150"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rol *" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="Rol" DisplayMemberPath="Etiqueta" SelectionChanged="Rol_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tarifa por hora (€) *" Style="{StaticResource Label}"/>
                            <TextBox x:Name="Tarifa" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PanelGrupo">
                        <TextBlock Text="Grupo / ciclo" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="Grupo" DisplayMemberPath="Nombre"/>
                        <TextBlock Text="Solo los usuarios técnicos se añaden a un grupo." Style="{StaticResource Muted}"/>
                    </StackPanel>

                    <StackPanel x:Name="PanelPassword">
                        <TextBlock Text="Contraseña inicial *" Style="{StaticResource Label}"/>
                        <PasswordBox x:Name="Password"/>
                        <TextBlock Text="Mínimo 8 caracteres. Comunícasela a la persona; se guarda cifrada con BCrypt."
                                   Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,60,0,0">
                <StackPanel>
                    <TextBlock Text="Permisos del rol" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="RolTitulo" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RolTexto" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="RolLimite" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="Error" Style="{StaticResource ErrorText}"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="Guardar" Content="Crear usuario" Style="{StaticResource PrimaryButton}" Click="Guardar_Click"/>
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Cancelar_Click"/>
        </StackPanel>
        <TextBlock Text="* Campos obligatorios" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
