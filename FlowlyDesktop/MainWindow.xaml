<Window x:Class="FlowlyDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FlowlyDesktop.Views"
        Title="Flowly · Administración" Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource BodyFont}" FontSize="13.5">
    <Grid>
        <!-- Pantalla de acceso -->
        <v:LoginView x:Name="Login"/>

        <!-- Aplicacion (cabecera + menu + contenido) -->
        <Grid x:Name="ShellGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="34" Height="26">
                            <Canvas Width="240" Height="170">
                                <Path Stroke="{StaticResource Blue}" StrokeThickness="21.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M61,107.5 C70,92 78,66.5 93,66.5 C118,66.5 124,136.3 146,136.3 C154.2,136.3 160.2,127.5 166.2,119.5 L222.5,42.2"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Flowly" FontFamily="{StaticResource TitleFont}" FontSize="22"
                                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Centro FP · Curso 2026–27" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="|" Margin="14,0" Foreground="{StaticResource Line}"/>
                        <TextBlock x:Name="UsuarioTxt" FontWeight="SemiBold"/>
                        <TextBlock Text="|" Margin="14,0" Foreground="{StaticResource Line}"/>
                        <Button Content="Cerrar sesión" Style="{StaticResource LinkButton}" Click="CerrarSesion_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Menu lateral -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="12,18,12,12">
                        <TextBlock Text="ADMINISTRACIÓN" FontSize="11" Foreground="{StaticResource Muted}" Margin="12,0,0,10"/>
                        <RadioButton x:Name="NavProyectos" Content="Proyectos" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="Proyectos"/>
                        <RadioButton x:Name="NavUsuarios" Content="Usuarios" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="Usuarios"/>
                        <RadioButton x:Name="NavTareas" Content="Tareas" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="Tareas"/>
                        <RadioButton x:Name="NavRoles" Content="Roles" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="Roles"/>
                        <RadioButton x:Name="NavInformes" Content="Informes" Style="{StaticResource NavItem}" Click="Nav_Click" Tag="Informes"/>
                        <Separator Margin="0,14" Background="{StaticResource Line}"/>
                        <TextBlock Text="Proyecto académico de FP" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="12,0"/>
                    </StackPanel>
                </Border>

                <!-- Contenido -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="Host" Margin="28,22,28,28"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
